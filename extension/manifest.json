{
  "manifest_version": 3,
  "name": "EasyMail pour Outlook Web",
  "version": "1.0.0",
  "description": "Assistant email intelligent — overlay EasyMail pour Outlook Web (outlook.office365.com)",

  "permissions": [
    "activeTab"
  ],

  "host_permissions": [
    "https://localhost:3443/*"
  ],

  "content_scripts": [
    {
      "matches": [
        "https://outlook.office365.com/*",
        "https://outlook.office.com/*",
        "https://outlook.live.com/*",
        "https://outlook.cloud.microsoft/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],

  "background": {
    "service_worker": "background.js"
  },

  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "128": "icons/icon-128.png"
  }
}
