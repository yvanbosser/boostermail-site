<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<OfficeApp
  xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0"
  xmlns:mailappor="http://schemas.microsoft.com/office/mailappversionoverrides/1.0"
  xsi:type="MailApp">

  <Id>a1b2c3d4-e5f6-7890-abcd-ef1234567890</Id>
  <Version>1.3.0.0</Version>
  <ProviderName>EasyMail</ProviderName>
  <DefaultLocale>fr-FR</DefaultLocale>
  <DisplayName DefaultValue="EasyMail"/>
  <Description DefaultValue="Assistant email intelligent - Generez des reponses adaptees a votre style"/>
  <IconUrl DefaultValue="https://localhost:3443/plugin/assets/icon-32.png"/>
  <HighResolutionIconUrl DefaultValue="https://localhost:3443/plugin/assets/icon-80.png"/>

  <SupportUrl DefaultValue="https://localhost:3443"/>

  <AppDomains>
    <AppDomain>https://localhost:3443</AppDomain>
  </AppDomains>

  <Hosts>
    <Host Name="Mailbox"/>
  </Hosts>

  <Requirements>
    <Sets>
      <Set Name="Mailbox" MinVersion="1.5"/>
    </Sets>
  </Requirements>

  <FormSettings>
    <Form xsi:type="ItemRead">
      <DesktopSettings>
        <SourceLocation DefaultValue="https://localhost:3443/plugin/taskpane.html"/>
        <RequestedHeight>250</RequestedHeight>
      </DesktopSettings>
    </Form>
  </FormSettings>

  <Permissions>ReadWriteItem</Permissions>

  <Rule xsi:type="RuleCollection" Mode="Or">
    <Rule xsi:type="ItemIs" ItemType="Message" FormType="Read"/>
  </Rule>

  <!-- VersionOverrides 1.0 : bouton ruban + taskpane (fallback 2019/2021) -->
  <VersionOverrides xmlns="http://schemas.microsoft.com/office/mailappversionoverrides" xsi:type="VersionOverridesV1_0">
    <Requirements>
      <bt:Sets DefaultMinVersion="1.5">
        <bt:Set Name="Mailbox"/>
      </bt:Sets>
    </Requirements>

    <Hosts>
      <Host xsi:type="MailHost">
        <DesktopFormFactor>
          <FunctionFile resid="functionFileUrl"/>

          <ExtensionPoint xsi:type="MessageReadCommandSurface">
            <OfficeTab id="TabDefault">
              <Group id="easymailGroup">
                <Label resid="groupLabel"/>
                <Control xsi:type="Button" id="easymailTaskpaneButton">
                  <Label resid="buttonLabel"/>
                  <Supertip>
                    <Title resid="buttonLabel"/>
                    <Description resid="buttonDesc"/>
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="icon16"/>
                    <bt:Image size="32" resid="icon32"/>
                    <bt:Image size="80" resid="icon80"/>
                  </Icon>
                  <Action xsi:type="ShowTaskpane">
                    <SourceLocation resid="taskpaneUrl"/>
                  </Action>
                </Control>
              </Group>
            </OfficeTab>
          </ExtensionPoint>
        </DesktopFormFactor>
      </Host>
    </Hosts>

    <Resources>
      <bt:Images>
        <bt:Image id="icon16" DefaultValue="https://localhost:3443/plugin/assets/icon-16.png"/>
        <bt:Image id="icon32" DefaultValue="https://localhost:3443/plugin/assets/icon-32.png"/>
        <bt:Image id="icon80" DefaultValue="https://localhost:3443/plugin/assets/icon-80.png"/>
      </bt:Images>
      <bt:Urls>
        <bt:Url id="functionFileUrl" DefaultValue="https://localhost:3443/plugin/commands.html"/>
        <bt:Url id="taskpaneUrl" DefaultValue="https://localhost:3443/plugin/taskpane.html"/>
      </bt:Urls>
      <bt:ShortStrings>
        <bt:String id="groupLabel" DefaultValue="EasyMail"/>
        <bt:String id="buttonLabel" DefaultValue="EasyMail"/>
      </bt:ShortStrings>
      <bt:LongStrings>
        <bt:String id="buttonDesc" DefaultValue="Ouvrir le panneau EasyMail pour repondre intelligemment"/>
      </bt:LongStrings>
    </Resources>

    <!-- VersionOverrides 1.1 : boutons + LaunchEvent + Runtimes -->
    <VersionOverrides xmlns="http://schemas.microsoft.com/office/mailappversionoverrides/1.1" xsi:type="VersionOverridesV1_1">
      <Requirements>
        <bt:Sets DefaultMinVersion="1.10">
          <bt:Set Name="Mailbox"/>
        </bt:Sets>
      </Requirements>

      <Hosts>
        <Host xsi:type="MailHost">
          <!-- Runtime pour LaunchEvent -->
          <Runtimes>
            <Runtime resid="autorunHtmlUrl">
              <Override type="javascript" resid="autorunJsUrl"/>
            </Runtime>
          </Runtimes>

          <DesktopFormFactor>
            <!-- #2/#5/#11 audit : FunctionFile pointe vers autorun (shared runtime complet)
                 au lieu de commands.html (qui ne gere pas le compose ni le notifyBackend) -->
            <FunctionFile resid="autorunHtmlUrl"/>

            <!-- Bouton lecture : ouvre le dialog -->
            <ExtensionPoint xsi:type="MessageReadCommandSurface">
              <OfficeTab id="TabDefault">
                <Group id="easymailReadGroup">
                  <Label resid="groupLabel"/>
                  <Control xsi:type="Button" id="easymailDialogButton">
                    <Label resid="buttonLabel"/>
                    <Supertip>
                      <Title resid="buttonLabel"/>
                      <Description resid="buttonDesc"/>
                    </Supertip>
                    <Icon>
                      <bt:Image size="16" resid="icon16"/>
                      <bt:Image size="32" resid="icon32"/>
                      <bt:Image size="80" resid="icon80"/>
                    </Icon>
                    <Action xsi:type="ExecuteFunction">
                      <FunctionName>openEasyMailDialog</FunctionName>
                    </Action>
                  </Control>
                </Group>
              </OfficeTab>
            </ExtensionPoint>

            <!-- Bouton compose -->
            <ExtensionPoint xsi:type="MessageComposeCommandSurface">
              <OfficeTab id="TabDefault">
                <Group id="easymailComposeGroup">
                  <Label resid="groupLabel"/>
                  <Control xsi:type="Button" id="easymailComposeButton">
                    <Label resid="buttonLabel"/>
                    <Supertip>
                      <Title resid="buttonLabel"/>
                      <Description resid="buttonDesc"/>
                    </Supertip>
                    <Icon>
                      <bt:Image size="16" resid="icon16"/>
                      <bt:Image size="32" resid="icon32"/>
                      <bt:Image size="80" resid="icon80"/>
                    </Icon>
                    <Action xsi:type="ExecuteFunction">
                      <FunctionName>openEasyMailDialog</FunctionName>
                    </Action>
                  </Control>
                </Group>
              </OfficeTab>
            </ExtensionPoint>

            <!-- LaunchEvent : OnNewMessageCompose -->
            <ExtensionPoint xsi:type="LaunchEvent">
              <LaunchEvents>
                <LaunchEvent Type="OnNewMessageCompose" FunctionName="onNewMessageComposeHandler"/>
              </LaunchEvents>
              <SourceLocation resid="autorunHtmlUrl"/>
            </ExtensionPoint>
          </DesktopFormFactor>
        </Host>
      </Hosts>

      <Resources>
        <bt:Images>
          <bt:Image id="icon16" DefaultValue="https://localhost:3443/plugin/assets/icon-16.png"/>
          <bt:Image id="icon32" DefaultValue="https://localhost:3443/plugin/assets/icon-32.png"/>
          <bt:Image id="icon80" DefaultValue="https://localhost:3443/plugin/assets/icon-80.png"/>
        </bt:Images>
        <bt:Urls>
          <bt:Url id="autorunHtmlUrl" DefaultValue="https://localhost:3443/plugin/autorun.html"/>
          <bt:Url id="autorunJsUrl" DefaultValue="https://localhost:3443/plugin/autorunshared.js"/>
          <bt:Url id="functionFileUrl" DefaultValue="https://localhost:3443/plugin/commands.html"/>
          <bt:Url id="taskpaneUrl" DefaultValue="https://localhost:3443/plugin/popup.html?container=taskpane"/>
        </bt:Urls>
        <bt:ShortStrings>
          <bt:String id="groupLabel" DefaultValue="EasyMail"/>
          <bt:String id="buttonLabel" DefaultValue="EasyMail"/>
        </bt:ShortStrings>
        <bt:LongStrings>
          <bt:String id="buttonDesc" DefaultValue="Ouvrir le panneau EasyMail pour repondre intelligemment"/>
        </bt:LongStrings>
      </Resources>
    </VersionOverrides>
  </VersionOverrides>
</OfficeApp>
